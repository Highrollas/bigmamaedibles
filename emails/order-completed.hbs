<div style="color:#000;font-family:'Helvetica Neue',Helvetica,Roboto,Arial,sans-serif;font-size:14px;line-height:150%;text-align:left"
      align="left">

      <div style="text-align:center;margin-bottom:20px;width:100%" align="center" width="100%">
            <div style="width:100%;text-align:center;margin-bottom:20px" width="100%" align="center">
                  <img src="https://bigmamasedibles.cc/assets/images/logo.png" height="90" alt="bigmamasedibles logo">
            </div>

            <div style="text-align:left" align="left">Hello {{checkoutObj.billingObj.firstName}},</div><br>

            <div style="text-align:left" align="left">
                  <div style="width:100%;" width="100%">
                        This Email Is To Confirm That Your Order <span
                              style="color:#162ff1;">#{{checkoutObj.orderId}}</span> Was Successfully Delivered.
                        We Hope We Have Met Your Standards And That Your Experience Using Our Service Was A Pleasant
                        One.
                        <br><br>
                        Enjoy Your Session, We Look Forward To Seeing You Again Soon.
                        <p>If You Have Any Questions Or Problems With Your Order, Get In Touch With Us Below</p>
                  </div>
                  {{> contact-btn}}
            </div>
      </div>

      <div style="width:100%;text-align:center;margin-top:20px;margin-bottom:20px" width="100%" align="center">
            <h2><span style="color:black;">Order Number #{{checkoutObj.orderId}}</span></h2>
      </div>

      <div style="margin-bottom:40px;">
            <table class="td" cellspacing="0" cellpadding="6" border="1"
                  style="color:#000;width:100%;font-family:'Helvetica Neue',Helvetica,Roboto,Arial,sans-serif;text-align:center;border:1px solid black;"
                  width="100%">
                  <thead>
                        <tr>
                              <th class="td" scope="col" style="color:#000;width:15%;text-align:center;" width="15%"
                                    align="center">Image</th>
                              <th class="td" scope="col" style="color:#000;width:40%;text-align:center;" width="40%"
                                    align="center">Product</th>
                              <th class="td" scope="col" style="color:#000;width:15%;text-align:center;" width="15%"
                                    align="center">Quantity</th>
                              <th class="td" scope="col" style="color:#000;width:30%;text-align:center;" width="30%"
                                    align="center">Subtotal</th>
                        </tr>
                  </thead>
                  <tbody>
                        {{#each checkoutObj.cartItems}}
                        <tr>
                              <td class="td" style="color:#000;padding:12px;text-align:center" align="center">
                                    <img width="24" height="32" src="{{this.productObj.images.[0]}}"
                                          class="attachment-32x32 size-32x32" alt="{{this.productObj.name}}">
                              </td>
                              <td class="td" style="color:#000;padding:12px;text-align:center" align="center">
                                    {{this.productObj.name}}
                              </td>
                              <td class="td" style="color:#000;padding:12px;text-align:center" align="center">
                                    {{this.cartQty}}
                              </td>
                              <td class="td" style="color:#000;padding:12px;text-align:center" align="center">
                                    <span class="woocommerce-Price-amount amount">
                                          <span class="woocommerce-Price-amount amount">
                                                <span class="woocommerce-Price-currencySymbol">£</span>
                                                {{#if (eq this.productType "Bundles")}}
                                                {{this.bundleVariation.price}}
                                                {{else}}
                                                {{multiply this.productObj.price this.cartQty}}
                                                {{/if}}
                                          </span>
                                    </span>
                              </td>
                        </tr>
                        {{/each}}
                  </tbody>
                  <tfoot>
                        <tr>
                              <th class="td" scope="row" colspan="2" style="color:#000;text-align:center;width:40%;"
                                    align="center" width="40%">Shipping:</th>
                              <td class="td" colspan="4" style="color:#000;padding:12px;text-align:center;width:60%;"
                                    align="center" width="60%">
                                    <span class="shipped_via">{{checkoutObj.shippingMethod.name}}</span>
                              </td>
                        </tr>
                        <tr>
                              <th class="td" scope="row" colspan="2" style="color:#000;text-align:center;width:40%;"
                                    align="center" width="40%">Total:</th>
                              <td class="td" colspan="4" style="color:#000;padding:12px;text-align:center;width:60%;"
                                    align="center" width="60%">
                                    <span class="woocommerce-Price-amount amount">
                                          <span
                                                class="woocommerce-Price-currencySymbol">£</span>{{checkoutObj.amountTotal}}</span>
                              </td>
                        </tr>
                  </tfoot>
            </table>
      </div>

      <table id="addresses" cellspacing="0" cellpadding="0" border="0"
            style="width:100%;vertical-align:top;margin-bottom:40px;padding:0;text-align:center;" width="100%">
            <tr>
                  <td valign="top" width="50%" style="text-align:left;border:0;padding:0;" align="left">
                        <div style="text-align:center;width:100%;" align="center" width="100%">
                              <h2>Delivery Details</h2>
                        </div>
                        <div style="border:2px solid white;width:100%;margin:auto;text-align:center;" width="100%"
                              align="center">
                              <address class="address" style="text-align:center;">
                                    {{checkoutObj.billingObj.firstName}} {{checkoutObj.billingObj.lastName}}<br>
                                    {{checkoutObj.billingObj.addressObj.street}}<br>
                                    {{checkoutObj.billingObj.addressObj.city}}<br>
                                    {{#if checkoutObj.billingObj.addressObj.state}}
                                    {{checkoutObj.billingObj.addressObj.state}}<br>
                                    {{/if}}
                                    {{checkoutObj.billingObj.addressObj.postcode}}<br>
                                    {{checkoutObj.billingObj.email}}
                              </address>
                        </div>
                  </td>
            </tr>
      </table>

</div>

{{> footer}}